# =============================================
# TerraShield Insurance — Environment Variables
# =============================================

# Mock Mode (set to false to use real APIs)
VITE_USE_MOCK_DATA=true

# API Base URL (your backend/BFF URL in production)
VITE_API_BASE_URL=/api

# ------- Zoho CRM -------
# Never expose client_secret or refresh_token to the browser.
# These should only be set in your backend/server environment.
CRM_API_BASE_URL=https://www.zohoapis.com/crm/v3
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_REFRESH_TOKEN=
CRM_PORTAL_ACCOUNT_ID=

# Frontend-safe CRM base URL (proxy through your backend)
VITE_CRM_API_BASE_URL=

# ------- Zoho Desk -------
# Never expose client_secret or refresh_token to the browser.
# These should only be set in your backend/server environment.
DESK_API_BASE_URL=https://desk.zoho.com/api/v1
DESK_CLIENT_ID=
DESK_CLIENT_SECRET=
DESK_REFRESH_TOKEN=
DESK_ORG_ID=

# Frontend-safe Desk base URL (proxy through your backend)
VITE_DESK_API_BASE_URL=
